<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true">
		<!-- A0 补充：导出 agent.log 用——FileProvider 把 app 私有目录文件分享给系统面板（零权限） -->
		<provider
			android:name="androidx.core.content.FileProvider"
			android:authorities="com.eracore.maui.fileprovider"
			android:exported="false"
			android:grantUriPermissions="true">
			<meta-data
				android:name="android.support.FILE_PROVIDER_PATHS"
				android:resource="@xml/file_paths" />
		</provider>
	</application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- ADR-0019: 曾以 SAF 完全替代存储权限。
	     issues/15 取证：重新声明 MANAGE_EXTERNAL_STORAGE（「所有文件访问」特殊权限）——
	     声明本身不获权，授权走系统设置页 / appops（adb shell appops set ... allow）。
	     未授权时行为与既往完全一致（SAF 兜底）；IsExternalStorageManager 检测在 BridgeHost spec ID6。 -->
	<uses-permission
		android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
		tools:ignore="ScopedStorage" />
</manifest>
