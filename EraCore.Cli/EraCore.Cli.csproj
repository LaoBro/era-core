<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MinorShift.Emuera</RootNamespace>
    <AssemblyName>EraCore.Cli</AssemblyName>
    <DefineConstants>HEADLESS</DefineConstants>
    <!-- android 交叉编译（3.2 android-arm64 验证）：Kestrel/AspNetCore 无 android runtime pack
         （NETSDK1082），真实 Android 形态（MAUI 壳）只引 Core。android RID 下排除 Server
         引用并定义 ANDROID_NO_SERVER 条件编译符号（见 ServerRunner.cs/HeadlessEntry.cs）。 -->
    <DefineConstants Condition="'$(RuntimeIdentifier)' == 'android-arm64' or '$(RuntimeIdentifier)' == 'android-x64'">$(DefineConstants);ANDROID_NO_SERVER</DefineConstants>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- ===== NativeAOT 验证（分支 nativeaot-verify，3.2 实验，已收口到 Android MAUI 壳） =====
         NativeAOT 仅用于 Android（MAUI 壳，见 docs/2026.8.4.安卓性能优化2/nativeaot-verify-report.md），
         Cli 默认不做 AOT：Release 普通发布（含框架依赖 no-self-contained）不触发 PublishAot/ILLink 裁剪，
         避免 NETSDK1102（trim 要求 self-contained）。需要 win-x64 AOT 验证时显式传
         -p:PublishAot=true（此时必须 self-contained），SDK 会自动开启，无需在此声明。
         输出目录重定向见同目录 Directory.Build.props（bin-aot/obj-aot，
         须在 Common.props 导入前设置，故不放这里）。 -->
    <!-- Base*OutputPath 改到 bin-aot/obj-aot 后，SDK 默认 ItemExcludes 不再覆盖旧 bin/obj 字面目录；
         历史遗留 AssemblyInfo.cs 会被 glob 收进编译（CS0579 重复特性）——显式恢复排除，
         并补 obj-aot/**（android 交叉发布会把不同 RID 的 AssemblyInfo.cs 写进 obj-aot，Debug 构建 glob 误收）。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**;bin-aot/**;obj-aot/**</DefaultItemExcludes>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Minimum</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cli 引用 Core + Server：经 InternalsVisibleTo 访问 internal 成员
         （HeadlessRunner 调 GameLoopComposer.RunAsync / ServerRunner 调 KestrelGameServer 等）-->
    <ProjectReference Include="..\EraCore.Core\EraCore.Core.csproj" />
    <ProjectReference Include="..\EraCore.Server\EraCore.Server.csproj" Condition="'$(RuntimeIdentifier)' != 'android-arm64' and '$(RuntimeIdentifier)' != 'android-x64'" />
    <!-- legacy-plugin-compat：facade（AssemblyName=Emuera）随宿主输出，进入 deps.json/TPA，
         使存量插件引用的 `Emuera` 程序集可被 Default ALC 解析。android RID 交叉编译形态排除（非产品形态）。 -->
    <ProjectReference Include="..\EraCore.Compat.Emuera\EraCore.Compat.Emuera.csproj" Condition="'$(RuntimeIdentifier)' != 'android-arm64' and '$(RuntimeIdentifier)' != 'android-x64'" />
  </ItemGroup>

  <!-- ===== issue 05 / spec ID13：Vue 前端构建 + 静态资源服务 =====
       Vue build/copy target 已抽到 build/VueBuild.targets，参数化：
         VueDistDestination（默认 wwwroot\）/ ViteBase（默认 /）
         VueOutDir（默认 dist）/ VueSrcDir（默认 ..\EraCore.Web）
       Cli 用默认值，MAUI Import 时覆盖 ViteBase=./ VueOutDir=dist-maui 避免争用。 -->
  <!-- wwwroot/ 文件随 build/publish 复制到输出目录。
       PublishSingleFile=true（PropertyGroup 上方）下 wwwroot 是松散文件目录，不嵌入 exe，
       必须作为独立文件随 exe 分发。
       wwwroot/ 由 .gitignore 排除（构建产物不入库），由 VueBuild.targets 填充。
       注意：Content glob 在 project load 时评估，首次 build 时 wwwroot/ 尚为空，
       CopyVueFrontendToWwwroot target 内会直接 Copy 到 $(OutputPath)wwwroot/ 作为兜底。 -->
  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="..\build\VueBuild.targets" />

</Project>
