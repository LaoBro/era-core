<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>MinorShift.Emuera</RootNamespace>
    <AssemblyName>EraCore.Server</AssemblyName>
    <DefineConstants>HEADLESS</DefineConstants>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Minimum</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- 3.3（NativeAOT）：minimal API 请求委托生成器——PublishAot 时 SDK 只对 web 项目
         自动启用；Server 是库项目，Map* 调用须显式开生成器，否则 AOT 下走 RequestDelegateFactory
         反射路径，所有请求 500（RequestDelegateFactory 静态生成 + AOT 兼容性分析）。 -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <!-- 3.3 豁免（非静默 suppress，理由固定）：Results.Json(JsonObject, statusCode) 的
         JsonSerializerOptions 重载标 RequiresDynamicCode（IL2026/IL3050 分析器误报）——
         运行时经 ConfigureHttpJsonOptions 的 TypeInfoResolverChain(ServerJsonContext) 解析
         JsonObject，无反射；且 HttpJsonOptions 默认 UnsafeRelaxedJsonEscaping 保证 wire
         与托管时代逐字节一致（TypeInfo 显式注入方案会转义单引号为 \u0027，违反 wire 契约）。
         禁止再引入新 IL2xxx 豁免——新增需重新论证。 -->
    <WarningsNotAsErrors>IL2026;IL3050</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Server 剩余的 internal 类型（KestrelGameServer / WsConnectionHandler）
         被 Cli（ServerRunner 直接构造 KestrelGameServer）和 Tests（KestrelGameServerIdleTests
         直接构造 server handler）访问——必须 InternalsVisibleTo 给两者。
         （ServerJsonContext 已迁回 Core——POCO 本在 Core、双宿主共享；Kestrel 经 Core→Server 的
         InternalsVisibleTo 访问 ServerJsonContext.Default。共享层类型 Session/SessionRegistry/
         OutputHub/HttpSessionIO/GameConfigService/Controller 在 Core，Core 的 InternalsVisibleTo
         已覆盖 Server/Cli/Tests/Maui。）-->
    <InternalsVisibleTo Include="EraCore.Cli" />
    <InternalsVisibleTo Include="EraCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Server 引用 Core：经 InternalsVisibleTo 访问 internal 成员
         （GameLoopComposer.RunAsync / AgentJsonlProtocol / DisplayState / EmueraConsole 等，
         以及共享层 Session/SessionRegistry/OutputHub/HttpSessionIO/GameConfigService/Controller）-->
    <ProjectReference Include="..\EraCore.Core\EraCore.Core.csproj" />
  </ItemGroup>

</Project>
