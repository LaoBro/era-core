; 票 27：浮点核心最小夹具（snake profile）。
@SYSTEM_TITLE
	CALL FLOAT_MAIN
	INPUT

@FLOAT_MAIN
#DIMF DYNAMIC 倍率
#DIMF CONST 系数 = 1.5
#DIMF ARR, 3
#LOCALFSIZE 3
	倍率 = 系数
	倍率 *= 1.2
	LOCALF = 0.0
	LOCALF += 7 * 0.01
	PRINTVL TOINT(倍率 * 100)
	PRINTVL TOINT(LOCALF * 100)
	PRINTVL TOINT(POWER(1.4, 2) * 100)
	PRINTVL TOINT(ROUND(2.5))
	PRINTVL TOINT(1.)
	PRINTVL 1e4
	IF 倍率 > 1.0
		PRINTL GT
	ENDIF
	; 27c：字符串 ↔ 浮点、浮点数组内建、RESULTF
	PRINTVL TOINT(TOFLOAT("1.5") * 100)
	PRINTL TOSTRF(1.5, "F2")
	ARR:0 = 1.5
	ARR:1 = -2.0
	ARR:2 = 0.5
	PRINTVL TOINT(SUMARRAY(ARR) * 100)
	PRINTVL TOINT(MAXARRAY(ARR) * 100)
	PRINTVL MATCH(ARR, 0.5)
	RESULTF = 2.5
	PRINTVL TOINT(RESULTF * 100)
	RETURN
