<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>EraCore.Tests</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- issue 01：三项目拆分后，Tests 同时引用 Core（GlobalStatic/EmueraConsole/AgentJsonlProtocol 等）
       和 Server（KestrelGameServer/HttpSessionIO 等，KestrelGameServerIdleTests 直接构造 server handler）。
       Core 经 InternalsVisibleTo 暴露 internal 成员给 Tests。-->
  <ItemGroup>
    <ProjectReference Include="..\EraCore.Core\EraCore.Core.csproj" />
    <ProjectReference Include="..\EraCore.Server\EraCore.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="TestData\Phase0\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
